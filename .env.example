# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
# Choose one: SQLite (local), PostgreSQL/Neon, or Turso
DATABASE_URL=sqlite:///instance/app.db
# For PostgreSQL/Neon: postgresql://user:password@host:5432/dbname
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=info@pollination.africa

# Stripe Payment Gateway
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# DPO Payment Gateway (Tanzania Mobile Money & Cards)
# Contact DPO: support@dpogroup.com or +255 677 335 555
DPO_COMPANY_TOKEN=your-dpo-company-token
DPO_SERVICE_TYPE=your-service-type-code
DPO_CURRENCY=TZS
DPO_TEST_MODE=True

# DPO API URLs (defaults are set in config.py)
DPO_API_URL_TEST=https://secure1.sandbox.directpay.online
DPO_API_URL_LIVE=https://secure.3gdirectpay.com

# DPO Callback URLs (update with your domain)
DPO_REDIRECT_URL=http://localhost:5000/payments/dpo/callback
DPO_BACK_URL=http://localhost:5000/payments/cancel

# Payment Token Lifetime (hours) - Default: 5 hours
DPO_PAYMENT_TOKEN_LIFETIME=5

# Bank Details (for manual bank transfer option)
BANK_NAME=CRDB Bank
BANK_ACCOUNT_NAME=Pollination Africa
BANK_ACCOUNT_NUMBER=0123456789
BANK_SWIFT=CORUTZTZ
BANK_BRANCH=Dar es Salaam Main Branch

# Event Configuration
EVENT_NAME=Pollination Africa Summit 2026
EVENT_SHORT_NAME=Pollination Africa 2026
EVENT_DATE=29 September - 1 October 2026
EVENT_LOCATION=Arusha, Tanzania
EVENT_VENUE=Venue to be announced
EVENT_VENUE_SHORT=
EVENT_CITY=Arusha
EVENT_COUNTRY=Tanzania
EVENT_COUNTRY_CODE=TZ
EVENT_TIME=Daily 9am-5pm
EVENT_DURATION=3 Days

# Calendar dates (ISO 8601) — drive countdowns, JSON-LD, and per-day labels.
EVENT_START_DATE=2026-09-29
EVENT_END_DATE=2026-10-01
EVENT_START_TIME=09:00:00+03:00

# Pipe-separated theme per programme day; list length sets the number of days.
EVENT_DAY_THEMES=Science and Evidence|Innovation, AI and Technology|Policy, Investment and Green Enterprises

# Organization
ORGANIZATION_NAME=Pollination Africa
ORGANIZATION_ADDRESS="SAADIT Offices\nDar es Salaam, Tanzania"

# Contact Channels
CONTACT_EMAIL=info@pollination.africa
PARTNERSHIPS_EMAIL=partnerships@pollination.africa
PRESS_EMAIL=press@pollination.africa
REGISTRATION_EMAIL=registration@pollination.africa
EXHIBITORS_EMAIL=exhibitors@pollination.africa
SUPPORT_PHONE=+255 767 727 619
SUPPORT_WHATSAPP=+255 683 136 393
SUPPORT_HOURS=Mon-Fri: 9am-5pm EAT
WEBSITE_URL=https://pollination.africa

# Site-wide Announcement Bar
# Set ANNOUNCEMENT_ENABLED=False to hide the banner without removing markup.
ANNOUNCEMENT_ENABLED=True
ANNOUNCEMENT_MESSAGE=New event dates — the summit has moved to 29 September – 1 October 2026. Same city, venue to be announced.
